# /etc/lastroute-godot2/lastroute-godot2.env  (mode 0640, root:lastroute2)
# Loaded by systemd (EnvironmentFile=). Real process environment always wins over any .env file.
# NO real secrets in this template: deploy.sh generates the admin password on the server.

# --- listening ports (see docs/DEPLOY_VPS3.md "Port plan") ---
# The shipped Godot client hardcodes http://lastroute.kyttuslab.org:8105 and the relay on 1105.
# Change these only together with PRIMARY_BASE_URL in src/autoload/backend_client.gd.
HOST=0.0.0.0
LASTROUTE_HTTP_PORT=8105
LASTROUTE_RELAY_ENABLED=true
# Public name/address the room directory tells clients to send UDP to
LASTROUTE_RELAY_HOST=lastroute.kyttuslab.org
LASTROUTE_RELAY_PORT=1105
ENET_ROOM_TTL_SECONDS=60

# --- data (the unit's StateDirectory; the ONLY writable path) ---
LASTROUTE_DATA_DIR=/var/lib/lastroute-godot2
LASTROUTE_ACCOUNT_STORE=/var/lib/lastroute-godot2/accounts.json
# PUBLIC route state is written under <data>/lastroute/publicroom.json
# LASTROUTE_PUBLIC_ROUTE_SEED=PUBLIC-ROUTE

# --- owner account setup key: generated by deploy.sh (openssl rand), leave blank to disable ---
LASTROUTE_ADMIN_PASSWORD=

# --- updates: off by default. Enable only after KT provides a read-only GitHub token. ---
LASTROUTE_AUTO_UPDATE=false
LASTROUTE_RESTART_ON_GITHUB_UPDATE=false
# LASTROUTE_GITHUB_REPO=KyttuXD/LastRouteGodot2
# LASTROUTE_GITHUB_TAG=debug
# LASTROUTE_GITHUB_TOKEN=
# LASTROUTE_UPDATE_DIR=/var/lib/lastroute-godot2/updates
# LASTROUTE_UPDATE_MANIFEST=/var/lib/lastroute-godot2/updates/updates.debug.json

# --- rate limits / proxy ---
LASTROUTE_RATE_LIMIT_WINDOW_SECONDS=60
LASTROUTE_API_RATE_LIMIT=600
LASTROUTE_ACCOUNT_RATE_LIMIT=30
# true ONLY when every HTTP request arrives through the trusted nginx that sets X-Forwarded-For.
# With the game talking to :8105 directly this must stay false.
TRUST_PROXY=false
