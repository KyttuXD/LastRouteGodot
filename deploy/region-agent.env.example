# /etc/lastroute-agent/agent.env on a region VPS (owner root, group lastroute-region, mode 0640).
# Names only: real values are set on the server. LASTROUTE_AGENT_TOKEN is generated there, e.g.
#   openssl rand -hex 32
# and the same value goes into the directory's LASTROUTE_AGENT_TOKENS ("virginia:<token>,texas:<token>") on VPS 3.
LASTROUTE_REGION=virginia
LASTROUTE_REGION_LABEL=US East
LASTROUTE_AGENT_TOKEN=
LASTROUTE_DIRECTORY_URL=http://lastroute.kyttuslab.org:8105
# the headless game: a Linux export from scripts/build_dedicated_host.sh
LASTROUTE_GODOT_BIN=/opt/lastroute-region/current/game/LastRoute-Dedicated.x86_64
# this region's relay, advertised to clients for ping / hosting (stage c); leave empty until it runs
LASTROUTE_RELAY_ADDRESS=
LASTROUTE_RELAY_PORT=
# capacity: min(cores - 1, (RAM - 1 GB) / LASTROUTE_ROOM_MB), capped by LASTROUTE_MAX_ROOMS when set
LASTROUTE_ROOM_MB=700
LASTROUTE_MAX_ROOMS=
LASTROUTE_PORT_BASE=18100
