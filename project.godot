; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kyttu's Lab"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/KYTTU- The Last Route"
config/custom_user_dir_name.linuxbsd="godot/app_userdata/KYTTU- The Last Route"
config/version="0.0.1.0"
run/main_scene="res://scenes/boot_loading.tscn"
run/print_header=false
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="res://assets/branding/logo_1024.png"

[autoload]

CrashWatch="*res://src/autoload/crash_watch.gd"
PlatformProfile="*res://src/autoload/platform_profile.gd"
GameState="*res://src/autoload/game_state.gd"
Settings="*res://src/autoload/settings.gd"
RunSaves="*res://src/autoload/run_saves.gd"
MouseLock="*res://src/autoload/mouse_lock.gd"
Sound="*res://src/autoload/sound.gd"
Backend="*res://src/autoload/backend_client.gd"
UpdateManager="*res://src/autoload/update_manager.gd"
RoomState="*res://src/autoload/room_state.gd"
PublicRoute="*res://src/autoload/public_route.gd"
Playtest="*res://src/playtest/playtest_bridge.gd"

[audio]

driver/enable_input=true

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://src/ui/ref_theme.tres"

[importer_defaults]

; Generated mesh LODs decimate the few-hundred-triangle cube models once the 3D viewport LOD threshold is high
; (hand/limb loss on hunters, merged cubes on props), so every scene import keeps full detail.
scene={
"meshes/generate_lods": false
}

