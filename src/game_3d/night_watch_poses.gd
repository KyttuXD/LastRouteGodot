class_name NightWatchPoses
extends RefCounted

## Night Watch's shared pose library for the blocky hunter rig. The poses are DATA
## (assets/hunters_blocky/night_watch_poses.json, generated by
## tools/blocky_hunters/nw_poses.py): per-bone rotation/offset keys as deltas from the
## model's rest pose. This class compiles them into an AnimationLibrary per hunter model
## and adds it to the hunter's AnimationPlayer as "nw/<pose>", so no .glb is touched and
## every hunter on the identical rig gets every pose.
##
##   NightWatchPoses.play(hunter_view, "door_lurk")                      # loops until stopped
##   NightWatchPoses.play(hunter_view, "flinch", {"speed": 1.2})         # one-shot, then back to normal
##   NightWatchPoses.play_state(hunter_view, "at_door")                  # by Night Watch hunter state
##   NightWatchPoses.stop(hunter_view)

const DATA_PATH := "res://assets/hunters_blocky/night_watch_poses.json"
const LIBRARY := "nw"
const PELVIS_REST_Y := 0.796875
## The rig's bones, parents before children.
const BONES := ["Pelvis", "Belly", "Chest", "Head", "L-Arm", "L-Forearm", "L-Hand", "R-Arm", "R-Forearm", "R-Hand",
	"L-Thigh", "L-Calf", "L-Foot", "R-Thigh", "R-Calf", "R-Foot"]

static var _data := {}
static var _libraries := {}


static func data() -> Dictionary:
	if _data.is_empty():
		var file := FileAccess.open(DATA_PATH, FileAccess.READ)
		if file != null:
			var parsed: Variant = JSON.parse_string(file.get_as_text())
			if parsed is Dictionary:
				_data = parsed
	return _data


static func pose_ids() -> Array:
	return data().get("poses", {}).keys()


static func has_pose(pose_id: String) -> bool:
	return data().get("poses", {}).has(pose_id) or not HunterAddons.pose(pose_id).is_empty()


## A core pose, or a pose a rig add-on kit brings (clips on its runtime bones, see HunterAddons).
static func pose(pose_id: String) -> Dictionary:
	var core: Dictionary = data().get("poses", {}).get(pose_id, {})
	return core if not core.is_empty() else HunterAddons.pose(pose_id)


static func clip_name(pose_id: String) -> String:
	return "%s/%s" % [LIBRARY, pose_id]


## The pose a Night Watch hunter state maps to ("" when the state has none).
## `hunter_id` picks a hunter-specific pose where the data has one (Verrine's vent crawl), else the shared pose.
static func pose_for_state(state: String, hunter_id: String = "") -> String:
	var own: Dictionary = data().get("hunter_states", {}).get(hunter_id, {})
	if own.has(state):
		return String(own[state])
	return String(data().get("states", {}).get(state, ""))


static func limits() -> Dictionary:
	return data().get("limits", {})


# ------------------------------------------------------------------------------------------- compiling

## Adds the "nw" library to `player` (cached per hunter id). Safe to call again.
static func install(model: Node, player: AnimationPlayer, hunter_id: String = "") -> bool:
	if model == null or player == null or data().is_empty():
		return false
	var key := hunter_id if not hunter_id.is_empty() else str(model.get_instance_id())
	# a model with rig add-ons mounted gets its own library (the runtime bones carry tracks)
	if HunterAddons.rig_of(model) != null:
		key += "+addons"
	if not _libraries.has(key):
		_libraries[key] = build_library(model, player, hunter_id)
	if player.has_animation_library(LIBRARY):
		player.remove_animation_library(LIBRARY)
	player.add_animation_library(LIBRARY, _libraries[key])
	return true


static func build_library(model: Node, player: AnimationPlayer, hunter_id: String = "") -> AnimationLibrary:
	var library := AnimationLibrary.new()
	var root: Node = player.get_node_or_null(player.root_node)
	if root == null:
		root = model
	var nodes := {}
	var rest_q := {}
	var rest_p := {}
	for bone in BONES:
		var node := model.find_child(bone, true, false) as Node3D
		if node == null:
			continue
		nodes[bone] = node
		rest_q[bone] = node.quaternion
		rest_p[bone] = node.position
	var pelvis_y: float = (rest_p["Pelvis"] as Vector3).y if rest_p.has("Pelvis") else PELVIS_REST_Y
	var leg_scale := pelvis_y / PELVIS_REST_Y
	var offsets: Dictionary = data().get("hunter_offsets", {}).get(hunter_id, {})
	leg_scale *= float(offsets.get("scale_pos", 1.0))
	var extra_rot: Dictionary = offsets.get("bone_rot", {})
	var all_poses: Array = pose_ids().duplicate()
	var addon_poses: Dictionary = HunterAddons.poses_for(hunter_id) if not hunter_id.is_empty() else {}
	for addon_id in addon_poses:
		all_poses.append(addon_id)
	for pose_id in all_poses:
		var spec: Dictionary = addon_poses[pose_id] if addon_poses.has(pose_id) else pose(pose_id)
		var animation := Animation.new()
		animation.length = float(spec["length"])
		animation.loop_mode = Animation.LOOP_LINEAR if spec.get("loop", true) else Animation.LOOP_NONE
		var ease_value := float(spec.get("ease", 1.0))
		for bone in spec["tracks"]:
			if not nodes.has(bone):
				# a runtime bone (a rig add-on): found on the mounted model, its rest pose is what it was mounted with
				var extra := model.find_child(bone, true, false) as Node3D
				if extra == null:
					continue
				nodes[bone] = extra
				rest_q[bone] = extra.quaternion
				rest_p[bone] = extra.position
			if not nodes.has(bone):
				continue
			var path := NodePath(String(root.get_path_to(nodes[bone])))
			var tracks: Dictionary = spec["tracks"][bone]
			if not tracks.get("rot", []).is_empty():
				var track := animation.add_track(Animation.TYPE_ROTATION_3D)
				animation.track_set_path(track, path)
				animation.track_set_interpolation_type(track, Animation.INTERPOLATION_CUBIC
					if spec.get("loop", true) else Animation.INTERPOLATION_LINEAR)
				animation.track_set_interpolation_loop_wrap(track, spec.get("loop", true))
				var add_rot := Vector3.ZERO
				if extra_rot.has(bone):
					add_rot = Vector3(float(extra_rot[bone][0]), float(extra_rot[bone][1]), float(extra_rot[bone][2]))
				for key in tracks["rot"]:
					var delta := key_quaternion(Vector3(key[1], key[2], key[3]) + add_rot)
					var index := animation.rotation_track_insert_key(track, float(key[0]), delta * (rest_q[bone] as Quaternion))
					if ease_value != 1.0:
						animation.track_set_key_transition(track, index, ease_value)
			if not tracks.get("pos", []).is_empty():
				var track := animation.add_track(Animation.TYPE_POSITION_3D)
				animation.track_set_path(track, path)
				animation.track_set_interpolation_type(track, Animation.INTERPOLATION_LINEAR)
				for key in tracks["pos"]:
					var offset := Vector3(key[1], key[2], key[3]) * leg_scale
					animation.position_track_insert_key(track, float(key[0]), (rest_p[bone] as Vector3) + offset)
		library.add_animation(pose_id, animation)
	return library


## Euler degrees (x, y, z) as a delta rotation in the parent's space.
static func key_quaternion(degrees: Vector3) -> Quaternion:
	return Quaternion.from_euler(Vector3(deg_to_rad(degrees.x), deg_to_rad(degrees.y), deg_to_rad(degrees.z)))


# ------------------------------------------------------------------------------------------- playing

## opts: speed (float, default 1), blend (seconds, default the pose's own), loop (bool, override).
## Works on a HunterView3D (it keeps the pose until stop(), through its own _update_animation)
## or on any node that holds the hunter model's AnimationPlayer.
static func play(target: Node, pose_id: String, opts: Dictionary = {}) -> bool:
	if target == null or not has_pose(pose_id):
		return false
	if target is HunterView3D:
		var view := target as HunterView3D
		view.nw_pose = pose_id
		view.nw_pose_opts = opts
		return view.has_nw_pose()
	var player := ModelSlot.find_animation_player(target)
	if player == null:
		return false
	if not player.has_animation_library(LIBRARY):
		install(target, player)
	var spec := pose(pose_id)
	player.speed_scale = float(opts.get("speed", 1.0))
	player.play(clip_name(pose_id), float(opts.get("blend", spec.get("blend", .3))))
	return true


static func play_state(target: Node, state: String, opts: Dictionary = {}) -> bool:
	var hunter_id := String(opts.get("hunter_id", ""))
	if hunter_id.is_empty() and target is HunterView3D:
		hunter_id = (target as HunterView3D).shown_id()
	var pose_id := pose_for_state(state, hunter_id)
	return not pose_id.is_empty() and play(target, pose_id, opts)


static func stop(target: Node) -> void:
	if target is HunterView3D:
		(target as HunterView3D).nw_pose = ""
		return
	var player := ModelSlot.find_animation_player(target)
	if player != null and player.has_animation("idle"):
		player.play("idle", .3)
