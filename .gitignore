# Godot 4 generated files
.godot/

# Exported builds
builds/
dist/

# Local editor/OS files
.DS_Store
Thumbs.db
*.tmp
*.log

# Local secrets and account data
.env
data/accounts.json


# Python bytecode from tools/
__pycache__/
*.pyc

# Character build intermediates. `tools/characters/build_hunters.py` writes a
# .bbmodel next to each .glb so a model can be opened in Blockbench, but the
# pipeline runs skin -> model: a hand edit here is overwritten by the next
# rebuild, so the .glb is the committed artefact and this is scratch.
art/props-3d/characters/*.bbmodel
