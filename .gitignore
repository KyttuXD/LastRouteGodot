# Godot 4 generated files
.godot/

# Exported builds
builds/
dist/
android/*
android/build/*

# Local editor/OS files
.DS_Store
Thumbs.db
*.tmp
*.log

# Local secrets and account data
.env
.data/
data/accounts.json
backend/data/
updates/
