.artifacts/
meshy_output/
art/props-3d/**/previews/

# Blender's automatic previous-save copies are recoverable local backups, not
# authored source. Keep the deliberate .blend files, runtime GLBs and atlases.
*.blend1


# Python bytecode from tools/
__pycache__/
*.pyc
.venv/
build/

# playtest output (docs/PLAYTEST.md)
.playtest/
.playtest-results/

# Built by tools/android/build_installer_plugin.sh (docs/XR_ANDROID.md); never committed
addons/kyttu_installer/bin/
.validate_timings.json
